# Code-only repository: everything is local unless explicitly allowed.
*
!*/
!.gitignore
!*.py
!*.cpp
!*.c
!*.hpp
!*.h
!*.ts
!*.tsx
!*.js
!*.css
!*.html
!*.sh
!*.toml
!Makefile
!Dockerfile
!LICENSE
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig.json
!/backend/pyrightconfig.json
!/backend/requirements.txt
!/tsconfig.json
# App icons are text-based SVG source required by the interface.
!/frontend/public/*.svg
# Always exclude documents, historical runs and generated/vendor code.
/docs/
/resource/
/Analysis/
/data/
/configs/
/.vscode/
/.cache/
/.agents/
/.codex/
/backend/files/
/backend/Analysis/**/*.ipynb
/archive/
/tools/visualization/lattice_plaquettes.svg
**/__pycache__/
**/node_modules/
**/venv/
**/.venv/
**/dist/
**/build/*.o
**/build/*.exe
**/build/*.dll
/benchmarks/results/

# Documents and publication assets, at any depth.
*.md
*.markdown
*.mdx
*.rst
*.txt
*.pdf
*.tex
*.bib
*.bst
*.cls
*.sty
*.doc
*.docx
*.odt
*.rtf
*.ppt
*.pptx
*.odp
*.xls
*.xlsx
*.ods
*.csv
*.ipynb
*.epub
*.ps
*.eps
*.aux
*.bbl
*.blg
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
# Document-related folders, wherever they appear (including capitalized names).
[dD]oc/
[dD]ocs/
[dD]ocument/
[dD]ocuments/
[dD]ocumentation/
[pP]aper/
[pP]apers/
[mM]anuscript/
[mM]anuscripts/
[pP]ublication/
[pP]ublications/
[oO]verleaf/
[rR]eference/
[rR]eferences/
[bB]ibliography/
[fF]igure/
[fF]igures/
[sS]ection/
[sS]ections/
[sS]upplementary/
[sS]upplement/
[rR]eport/
[rR]eports/
[pP]resentation/
[pP]resentations/
[sS]lides/
[nN]otes/
# Dependency manifest is required to install the code.
!/backend/requirements.txt
