# Code-only tracking policy. Paths beginning with / are relative to repo root.
# Ignore files by default; traverse folders to reach approved source paths.
*
!*/

# Repository configuration and copyright.
!/.gitignore
!/.editorconfig
!/.gitattributes
!/LICENSE

# Backend source, reference implementation and build recipes.
!/backend/**/*.py
!/backend/src/*.cpp
!/backend/benchmarks/*.cpp
!/backend/include/*.hpp
!/backend/pyrefly.toml
!/backend/pyrightconfig.json
!/backend/build/Makefile
!/backend/build/jobscript.sh
!/backend/build/launch_dir.py

# Frontend source, dependency manifests and tooling configuration.
!/frontend/.gitignore
!/frontend/Dockerfile
!/frontend/index.html
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig.json
!/frontend/*.js
!/frontend/*.ts
!/frontend/src/**/*.ts
!/frontend/src/**/*.tsx
!/frontend/src/**/*.js
!/frontend/src/**/*.css
!/frontend/public/*.svg

# Research tooling source only; results and manuscript assets remain local.
!/benchmarks/**/*.py
!/scripts/**/*.py
!/scripts/audit/*.cpp
!/tools/**/*.py

# Existing local-only folders in this repository.
/docs/
/archive/
/configs/
/data/
/.vscode/
/.cache/
/.agents/
/.codex/
/backend/files/
/benchmarks/results/
/frontend/src/assets/

# Generated products, dependencies, environments and machine-local files.
node_modules/
venv/
.venv/
__pycache__/
dist/
dist-ssr/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.env.*
*.local
*.py[cod]
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.tsbuildinfo
*.log
compile_commands.json

# Documents and publication assets, at any depth.
*.md
*.markdown
*.mdx
*.rst
*.txt
*.pdf
*.tex
*.bib
*.bst
*.cls
*.sty
*.doc
*.docx
*.odt
*.rtf
*.ppt
*.pptx
*.odp
*.xls
*.xlsx
*.ods
*.csv
*.ipynb
*.epub
*.ps
*.eps
*.aux
*.bbl
*.blg
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
# Document-related folders, wherever they appear (including capitalized names).
[dD]oc/
[dD]ocs/
[dD]ocument/
[dD]ocuments/
[dD]ocumentation/
[pP]aper/
[pP]apers/
[mM]anuscript/
[mM]anuscripts/
[pP]ublication/
[pP]ublications/
[oO]verleaf/
[rR]eference/
[rR]eferences/
[bB]ibliography/
[fF]igure/
[fF]igures/
[sS]ection/
[sS]ections/
[sS]upplementary/
[sS]upplement/
[rR]eport/
[rR]eports/
[pP]resentation/
[pP]resentations/
[sS]lides/
[nN]otes/
# Required dependency manifest: exception to the document *.txt rule.
!/backend/requirements.txt
